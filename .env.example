APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=/var/lib/canton-fair-alert/app.db
SNAPSHOT_DIR=/var/lib/canton-fair-alert/snapshots
SOURCES_FILE=/etc/canton-fair-alert/sources.json
SCHEDULE_REFRESH_TIME=12:00
ALERT_SEND_TIME=18:00
SCHEDULE_MAX_STALE_DAYS=180
ADMIN_ALERT_COOLDOWN_HOURS=24
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=CantonFairCommuteAlert/1.0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=广交会通勤提醒
SMTP_FROM_EMAIL=
ADMIN_EMAIL=
